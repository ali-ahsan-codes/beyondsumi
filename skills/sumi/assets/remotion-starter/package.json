{
  "name": "video-skill-project",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.tsx",
    "still": "remotion still src/index.tsx Film out/still.png",
    "draft": "remotion render src/index.tsx Film out/draft.mp4 --scale=0.5 --crf=25",
    "render": "npm run preflight && remotion render src/index.tsx Film out/film.mp4 --codec=h264 --crf=17 --color-space=bt709 --pixel-format=yuv420p",
    "audio:demo": "python3 scripts/make_demo_audio.py",
    "review": "python3 scripts/review_export.py out/film.mp4",
    "serve": "python3 scripts/serve.py",
    "preflight": "python3 scripts/validate_shot_plan.py shot-plan.json --stage proof",
    "physics": "python3 scripts/validate_physics.py shot-plan.json --stage proof"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "remotion": "4.0.516",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
